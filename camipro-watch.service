[Unit]
Description=Surveillance 24/7 des casiers EPFL MyCamipro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup
WorkingDirectory=/opt/camipro-watch
EnvironmentFile=/opt/camipro-watch/.env
ExecStart=/opt/camipro-watch/venv/bin/python /opt/camipro-watch/main.py
Restart=always
RestartSec=10
MemoryMax=40M

[Install]
WantedBy=multi-user.target
