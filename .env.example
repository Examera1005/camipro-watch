# Jeton Bearer Entra ID stocké dans localStorage de https://mycamipro2.epfl.ch
# Console navigateur (F12) : copy(localStorage.getItem('mycamipro.token.entra'))
MYCAMIPRO_BEARER_TOKEN="eyJ0eXAiOiJKV1Qi..."

# Refresh token Entra ID pour renouvellement automatique de la session (~90 jours)
# Console navigateur (F12) : copy(localStorage.getItem('mycamipro.token.entra.refresh'))
MYCAMIPRO_REFRESH_TOKEN="1.AQwA..."

# (Optionnel) Cookie JSESSIONID de camipro-axs-ext.epfl.ch
MYCAMIPRO_SESSION_COOKIE=""

# Endpoint REST de l'API des casiers EPFL
MYCAMIPRO_LOCKERS_URL="https://camipro-axs-ext.epfl.ch/axsapi/rest/v1"

# Intervalle de vérification EPFL en secondes (recommandé : 45)
POLL_INTERVAL="45"

# Bot Telegram (créé via @BotFather)
TELEGRAM_BOT_TOKEN="123456789:AAH_votre_token_botfather_ici"

# Liste des CHAT_ID abonnés (séparés par des virgules).
# Laissez vide au premier lancement : toute personne envoyant /start au bot est ajoutée automatiquement.
# Le premier ID de la liste est l'administrateur (/token, /refresh).
TELEGRAM_CHAT_ID=""

# Fichier de persistance d'état local
STATE_FILE="lockers_state.json"
