# Cookie SSO Microsoft 90 jours (Recommandé : permet de régénérer tout seul les jetons toutes les 24h)
# Dans F12 -> Application -> Cookies -> https://login.microsoftonline.com -> copiez la valeur de ESTSAUTHPERSISTENT
MYCAMIPRO_ESTS_COOKIE=""

# Jeton Bearer Entra ID stocké dans localStorage de https://mycamipro2.epfl.ch (généré automatiquement si MYCAMIPRO_ESTS_COOKIE est fourni)
MYCAMIPRO_BEARER_TOKEN=""

# Refresh token Entra ID SPA (valide 24h, régénéré automatiquement via MYCAMIPRO_ESTS_COOKIE)
MYCAMIPRO_REFRESH_TOKEN=""

# (Optionnel) Cookie JSESSIONID de camipro-axs-ext.epfl.ch
MYCAMIPRO_SESSION_COOKIE=""

# Endpoint REST de l'API des casiers EPFL
MYCAMIPRO_LOCKERS_URL="https://camipro-axs-ext.epfl.ch/axsapi/rest/v1"

# Intervalle de vérification EPFL en secondes (recommandé : 45)
POLL_INTERVAL="45"

# Bot Telegram (créé via @BotFather)
TELEGRAM_BOT_TOKEN="123456789:AAH_votre_token_botfather_ici"

# Liste des CHAT_ID abonnés (séparés par des virgules).
# Laissez vide au premier lancement : toute personne envoyant /start au bot est ajoutée automatiquement.
# Le premier ID de la liste est l'administrateur (/ests, /token, /refresh).
TELEGRAM_CHAT_ID=""

# Fichier de persistance d'état local
STATE_FILE="lockers_state.json"
